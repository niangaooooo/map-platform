# 协作地图标绘系统环境配置示例
# 复制为 .env 并填写真实值！

# ---------- 应用 ----------
APP_ENV=production
# 生成方式: openssl rand -hex 32
SECRET_KEY=change-me-to-a-long-random-secret
# 是否开放注册（推荐 false，由管理员创建账号）
ALLOW_REGISTER=false

# ---------- 数据库 ----------
POSTGRES_USER=map
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=map_platform
# 后端容器内无需修改 DATABASE_URL（由 compose 拼装）
# DATABASE_URL=postgresql+asyncpg://map:xxx@localhost:5432/map_platform

# ---------- Redis ----------
# Docker 部署：redis://redis:6379/0
# Windows 单端口部署（无 Redis）：fakeredis://local（内存实现，仅限单进程）
REDIS_URL=redis://localhost:6379/0

# ---------- 单端口托管（Windows 无 nginx 部署） ----------
# 设置后后端同时托管前端 dist，一个端口 = 页面 + API + WS（详见 DEPLOY_WINDOWS.md）
SERVE_STATIC_DIR=

# ---------- 高德地图 ----------
# ① 高德开放平台申请 JS API Key：https://console.amap.com/
# ② 前端地图渲染（JS API）使用同一 Key，构建时注入 index.html —— 必须在控制台
#    配置「域名白名单」为你的站点域名（如 https://map.example.com），否则浏览器报 INVALID_USER_KEY
# ③ 后端 REST 代理（搜索/地理编码/逆地理）也使用同一 Key，Key 只存在服务端，不暴露给前端
AMAP_KEY=your-amap-js-api-key
# JS API 安全密钥（若在控制台开启「安全密钥」才需填写，与代理共用）
AMAP_SECURITY_CODE=your-amap-security-js-code
# 前端直连后端 amap-proxy 的共享密钥（留空则由登录态鉴权）
AMAP_PROXY_SECRET=

# ---------- Token ----------
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

# ---------- CORS ----------
CORS_ORIGINS=https://map.example.com