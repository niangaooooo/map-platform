# 测试板块配置模板：复制为 .env.test 并填写（.env.test 不入库）
# 作用：让"测试板块"后端（map_test_server.py，端口 8081）与正式环境完全隔离。

# 独立测试库（建议与正式库不同库名）
DATABASE_URL=postgresql+asyncpg://postgres:your-password@127.0.0.1:5432/map_platform_test

# 测试前端产物目录（用 `npx vite build --outDir dist-test --base /map-test/` 构建）
SERVE_STATIC_DIR=

# 与正式端不同的密钥（避免两端登录 token 通用）
SECRET_KEY=change-me-a-random-secret-different-from-prod

# 一键同步：测试端把项目推送到正式端所用的地址与共享密钥
SYNC_PROD_URL=http://127.0.0.1:8080/map/api/v1
SYNC_SHARED_SECRET=change-me-shared-secret

# 高德 Web 服务 Key（后端 REST 代理用；前端 JS Key 在 frontend/.env.local）
AMAP_KEY=
